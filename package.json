{
  "name": "sctl-nestjs-boilerplate",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "rimraf dist && nest build && copyfiles -f ./env/* ./dist/env && copyfiles package.json ./dist/ && copyfiles -f ./migrations/* ./dist/migrations && copyfiles -f ./templates/* ./dist/templates",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/main",
    "pm2:start:dev": "cross-env NODE_ENV=development pm2 start main.js --name sctl-nestjs-boilerplate --update-env",
    "pm2:start:prod": "cross-env NODE_ENV=production pm2 start main.js --name sctl-nestjs-boilerplate --update-env",
    "migrations:create": "migrate-mongo create",
    "migrations:dev:up": "cross-env NODE_ENV=development npx migrate-mongo up",
    "migrations:dev:down": "cross-env NODE_ENV=development npx migrate-mongo down",
    "migrations:dev:status": "cross-env NODE_ENV=development npx migrate-mongo status",
    "migrations:prod:up": "cross-env NODE_ENV=production npx migrate-mongo up",
    "migrations:prod:down": "cross-env NODE_ENV=production npx migrate-mongo down",
    "migrations:prod:status": "cross-env NODE_ENV=production npx migrate-mongo status",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cross-env": "^10.1.0",
    "handlebars": "^4.7.8",
    "migrate-mongo": "^14.0.7",
    "mongodb": "^7.1.0",
    "mongoose": "^9.2.1",
    "mongoose-autopopulate": "^1.2.1",
    "nodemailer": "^8.0.1",
    "nodemailer-express-handlebars": "^7.0.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
