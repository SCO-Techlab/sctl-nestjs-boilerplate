ENVIRONMENT=development
PORT=3000
PRODUCTION=false
HOST=localhost

MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_DATABASE=sctl-nestjs-boilerplate-development
MONGODB_AVOID_CONNECTION=false

JWT_SECRET=secret
JWT_ALGORITHM=HS256
JWT_SIGN_OPTIONS_EXPIRESIN=7d
JWT_SIGN_OPTIONS_ISSUER=auth-api-development
JWT_SIGN_OPTIONS_AUDIENCE=web-development,mobile-development
JWT_REFRESH_SECRET=refresh-secret
JWT_REFRESH_EXPIRESIN=30d
JWT_REFRESH_ISSUER=auth-api-development
JWT_REFRESH_AUDIENCE=web-development,mobile-development